# Application Settings
APP_NAME="Depression NLP Detector"
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API Settings
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=false
API__WORKERS=1

# Model Settings
MODEL__MODEL_TYPE=traditional
MODEL__BERT_MODEL_NAME=bert-base-uncased
MODEL__BERT_EPOCHS=3
MODEL__BERT_LEARNING_RATE=2e-5

# Data Settings
DATA__MAX_TEXT_LENGTH=512
DATA__TEST_SIZE=0.2
DATA__VAL_SIZE=0.1
DATA__RANDOM_SEED=42

# Optional: HuggingFace API token (for private datasets/models)
# HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxx

# Optional: MLflow tracking
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=depression-detection
